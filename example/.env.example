PORT=3000

# OpenObserve self-hosted: the endpoint includes the organization, but not /v1/<signal>.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default

# Authorization=Basic <base64(email:password)>. The space must be encoded as %20.
# This value matches root@example.com:Complexpass#123 in docker-compose.yml.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=

OTEL_SERVICE_NAME=nest-observe-example
OTEL_SERVICE_VERSION=1.0.0
OBSERVE_ENVIRONMENT=local
OTEL_RESOURCE_ATTRIBUTES=team=platform,example.name=openobserve
OTEL_METRIC_EXPORT_INTERVAL=10000
